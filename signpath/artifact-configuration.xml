<?xml version="1.0" encoding="utf-8"?>
<!--
  The artifact configuration to paste into the SignPath project (Artifact configurations > New).
  The release workflow uploads one zip per signing request holding a single .exe: first
  pob-forge.exe, then the NSIS installer. Each must say it is PoE Forge at the release's version,
  passed by the workflow as the "version" parameter.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="PoE Forge" product-version="${version}">
      <include path="*.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
